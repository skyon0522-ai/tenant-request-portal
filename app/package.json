{
  "name": "tenant-request-portal-payload",
  "version": "1.0.0",
  "description": "An example of a multi tenant application with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3230",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3230",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "build:plugin": "node ../scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "file:vendor/plugin-multi-tenant",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "16.9.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "qs-esm": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "chalk": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "typescript": "5.5.2",
    "playwright": "1.64.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "private": true,
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "dompurify": "3.4.16",
    "@payloadcms/next": {
      "sass": "1.105.1"
    },
    "postcss": "8.5.29",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
